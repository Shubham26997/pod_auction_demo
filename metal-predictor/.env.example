OPENAI_API_KEY=your_openai_api_key_here

# --- Qdrant connection -------------------------------------------------------
# Leave QDRANT_HOST empty to use embedded file mode (local dev, no Docker).
# Set QDRANT_HOST when running via docker-compose — the API container connects
# to the qdrant service automatically (docker-compose sets this for you).
#
# QDRANT_HOST=localhost    # use this to hit a local Qdrant server manually
# QDRANT_PORT=6333         # default Qdrant REST port

# --- Initial data window (used ONLY on the very first ingest) -------------
#
# Option A — specific start date (takes priority over DATA_PERIOD):
# DATA_START_DATE=2020-01-01
#
# Option B — relative yfinance period string (default: 5y):
# Valid values: 1d 5d 1mo 3mo 6mo 1y 2y 5y 10y ytd max
# DATA_PERIOD=5y
#
# After the first ingest every run is INCREMENTAL — only new trading days
# since the last stored end_date are fetched and appended automatically.
